# =============================================================================
# Vendora production environment
# =============================================================================
# Copy this file to `production.env` on the server, fill in real values, and
# keep it readable only by the deployment user:
#
#   install -m 600 deploy/env/production.env.example deploy/env/production.env
#   (then edit deploy/env/production.env)
#
# NEVER commit production.env. Values marked "generate" must be replaced with
# fresh random secrets:
#   openssl rand -hex 32
# =============================================================================

# --- Image registry (deployment) --------------------------------------------
# Lowercase GitHub user/org for ghcr.io images.
VENDORA_IMAGE_REGISTRY=ghcr.io/hamedsanaei

# Public hostname used by the deploy script for post-deploy health checks.
VENDORA_PUBLIC_HOST=vendora.tofanservice.ir

# --- API runtime secrets (generate) -----------------------------------------
# JWT HMAC signing key. Minimum 32 random bytes; MUST NOT be the development
# fallback value, otherwise the API refuses to start in Production.
Jwt__Key=CHANGE_ME_openssl_rand_hex_32

# JWT issuer and audience.
Jwt__Issuer=Vendora
Jwt__Audience=Vendora.Clients

# Invite code required to register the first admin account through the admin
# panel at /fa/admin/register. Generate a strong random value.
Auth__AdminInviteCode=CHANGE_ME_openssl_rand_hex_32

# CORS origins allowed to call the API directly (comma separated).
Cors__AllowedOrigins=https://vendora.tofanservice.ir

# --- Database ----------------------------------------------------------------
# Overridden by docker-compose.production.yml to the bind-mounted volume path;
# included here for clarity and for running the API image standalone.
ConnectionStrings__DefaultConnection=Data Source=/data/vendora.db
