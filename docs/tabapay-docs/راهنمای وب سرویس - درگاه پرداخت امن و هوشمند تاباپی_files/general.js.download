function formValidate(formID, refresh = true) {

    let form = $(`form${formID}`);
    let returnResponse = false;

    // اعتبارسنجی در لحظه روی فیلدهای مختلف
    form.find('input, textarea, select').on('input change blur', function () {
        $(this).valid();
    });
    // هندل کردن ارسال فرم
    form.on('submit', function (e) {
        let validator = $(this).data('validator');
        const validateAllFields = form.attr('data-validate-all-fields') === '1';
        let prevIgnore = validator ? validator.settings.ignore : undefined;
        if (validator && validateAllFields) {
            validator.settings.ignore = [];
        }
        if (!$(this).valid()) {
            if (validator && validateAllFields) {
                validator.settings.ignore = prevIgnore;
            }
            e.preventDefault();
            return false;
        }
        if (validator && validateAllFields) {
            validator.settings.ignore = prevIgnore;
        }
        if (form.attr('data-skip-ajax-validation') === '1') {
            return;
        }
        e.preventDefault();

            var formData = new FormData(form[0]);
            formData.append('type', 'ajax-validation');
            $.ajax({
                url: form.attr('action'),
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,

                success: function (response) {
                    if (refresh) {
                        form.off('submit').submit();
                    }
                    returnResponse = true;
                },

                error: function (response) {
                    // پاک کردن ارورهای قبلی
                    $('span.empty').remove();
                    var json = response.responseJSON;
                    if (!json && response.responseText) {
                        try {
                            json = JSON.parse(response.responseText);
                        } catch (parseError) {
                            json = null;
                        }
                    }
                    if (json && json.errors !== undefined) {
                        $.each(json.errors, function (key, value) {

                            var newElement = `<span id="${key}-error" class="${key}_span inputStatus empty">${value[0]}</span>`;

                            if (key === 'phone' || key === 'area_code') {
                                // برای فیلدهای خاص
                                form.find(`div.inputphonecontent`).after(newElement);

                            } else if (form.find(`input[name="${key}"]`).attr('type') === 'file') {
                                form.find(`input[name="${key}"]`).parent(`label.frmfile`).after(newElement);

                            } else {
                                if (key.indexOf('.') != -1) {
                                    key = key.replace('.', '[');
                                    key += ']';
                                }
                                // فیلدهای معمولی
                                form.find(`input[name="${key}"]`).after(newElement);
                                form.find(`select[name="${key}"]`).after(newElement);
                                form.find(`textarea[name="${key}"]`).after(newElement);
                            }
                        });
                    } else if (json && (json.message || json.status)) {
                        VanillaToasts.create({
                            positionClass: 'topCenter',
                            timeout: 8000,
                            type: json.status || 'error',
                            title: '',
                            text: json.message || '',
                            icon: (json.status || 'error') === 'error' ? '/assets/icons/close.svg' : '/assets/icons/tik-green.svg'
                    });
                    } else {
                        VanillaToasts.create({
                            positionClass: 'topCenter',
                            timeout: 8000,
                            type: 'error',
                            title: '',
                            text: 'خطا در ارتباط با سرور. لطفاً دوباره تلاش کنید.',
                            icon: '/assets/icons/close.svg'
                        });
                    }

                    returnResponse = false;
                }
            });
    });

    return returnResponse;
}


function formatNumber(n) {
    return n.replace(/\D/g, "").replace(/\B(?=(\d{3})+(?!\d))/g, ",")
}

