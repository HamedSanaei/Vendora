function formatCurrency(input, changeVal = true) {
    // const inputField = document.getElementById('numberInput');
    let value;
    if (changeVal) {
        value = input.val().replace(/[^0-9]/g, '');
    } else {
        value = input.replace(/[^0-9]/g, '');
    }

    if (value.length > 1 && value.startsWith('0')) {
        value = value.substring(1);
    }


    value = value.replace(/\B(?=(\d{3})+(?!\d))/g, ',');


    if (changeVal) {
        // inputField.value = value;
        input.val(value)
    } else {
        return value;
    }
}

// Helper function to format number (for example, adding commas)
function formatNumber(num) {
    if (num === "") return "";
    return parseInt(num, 10).toLocaleString("en-US");
}


