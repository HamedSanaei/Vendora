function download(url,transactionID) {
    // var time = (new Date).getTime();
    var a = $("<a style='display:none' id='js-downloder'>")
        .attr("href", url)
        .attr("download", `TabaPay-Receipt-${transactionID}.png`)
        .appendTo("body");

    a[0].click();

    a.remove();
}

