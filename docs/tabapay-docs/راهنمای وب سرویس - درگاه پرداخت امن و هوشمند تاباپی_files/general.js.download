function openPanelPopup(selector) {
    $("#menuShopSwitcher, #menuprofile, #menuNotic").stop(true, true).slideUp();
    $("body").addClass("is-popup-open");
    $(selector).fadeIn().css('display', 'flex');
}

function closePanelPopups() {
    $("body").removeClass("is-popup-open");
}

function ShowPopUp(PopupClass) {
    openPanelPopup("." + PopupClass);
}//end ShowPopUp

$(function () {
    $(document).on('click', '.popup:not(.popup-create-success-creditcard):not(.popup-rules-mandatory)', function (e) {
        if (e.target === this) {
            $(this).fadeOut();
            closePanelPopups();
        }
    });
    $(document).on('click', '.popup > div', function (e) {
        e.stopPropagation();
    });
    $(document).on('click', '.closePopUp', function () {
        closePanelPopups();
    });
});

// Function Copy Text
function CopyToClipboard(containerid) {
    var element = document.getElementById(containerid);
    var range;
    if (document.selection) {
        range = document.body.createTextRange();
        range.moveToElementText(element);
        range.select().createTextRange();
        document.execCommand("copy");
    } else if (window.getSelection) {
        range = document.createRange();
        range.selectNode(element);
        window.getSelection().removeAllRanges();
        window.getSelection().addRange(range);
        document.execCommand("copy");
    }//end else if

    $("#tooltip" + containerid).fadeIn();
    setTimeout(function () {
        $("#tooltip" + containerid).fadeOut();
    }, 1000);
}


function toggleLi(id) {
    const container = $('#FB-li' + id + ' > div:not(:first-of-type)');
    const isOpen = container.css('maxHeight') !== '0px' && container.css('maxHeight') !== '';
    const arrowIcon = $('#FB-li' + id + ' .toggleBtnIcon');

    if (isOpen) {
        // بسته‌سازیش
        container.css('maxHeight', '0');
        arrowIcon.removeClass('rotate-up').addClass('rotate-down');
    } else {
        // بازسازیش
        const fullHeight = container.prop('scrollHeight') + 'px';
        container.css('maxHeight', fullHeight);
        arrowIcon.removeClass('rotate-down').addClass('rotate-up');
    }
}




$(document).ready(function () {
    var oldDisplayStyles = [];

    // تابع مشاهده‌گر تغییرات
    var observer = new MutationObserver(function (mutations) {
        mutations.forEach(function (mutation) {
            if (mutation.type === 'attributes' && mutation.attributeName === 'style') {
                var target = $(mutation.target);
                var index = $('.popup').index(target);
                var newDisplayStyle = target.css('display');

                if (newDisplayStyle !== oldDisplayStyles[index]) {
                    if (newDisplayStyle === 'flex') {

                        $("body").css('overflow', 'hidden')

                    } else if (newDisplayStyle === 'none') {

                        $("body").css('overflow', 'visible')
                    }
                    oldDisplayStyles[index] = newDisplayStyle;
                }
            }
        });
    });

    // تعیین عناصر هدف برای مشاهده
    var targets = document.querySelectorAll('.popup');
    targets.forEach(function (target, index) {
        observer.observe(target, {
            attributes: true, // پایش تغییرات در ویژگی‌ها
            attributeOldValue: true // ذخیره مقدار قبلی ویژگی‌ها
        });
        oldDisplayStyles[index] = $(target).css('display');

    });

});
