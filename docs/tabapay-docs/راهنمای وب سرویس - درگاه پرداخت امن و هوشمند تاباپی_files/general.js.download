function RemoveLoading() {
    $('.loading').fadeOut();
}

$(document).ajaxSend(function (evt, request, settings) {
    if (settings.data !== 'operation=readPublicNotification' && !settings.skipGlobalLoading) {
        $('.popup').css('z-index', 1111);
        $('.loading').css('z-index', 1111113);
        $('.loading').fadeIn();
    }
}).ajaxStop(function () {
    $('.loading').fadeOut();
    // $('.popup').css('z-index', 1111112);
    $('.popup').css('z-index', 1111);
    $('form').find('button[type=submit]').prop("disabled", false);
});


