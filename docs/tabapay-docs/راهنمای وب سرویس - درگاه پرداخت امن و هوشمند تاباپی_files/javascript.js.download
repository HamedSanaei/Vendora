    //-------------- preview image
    $(document).on('change', 'input[data-getImg=true]', function () {
        let inputEle = $(this);
        if ($(this).attr('class') !== 'ticketUpload') {
            var file = this.files[0];

            if (file) {
                var fileName = file.name;
                var fileExt = fileName.split('.').pop().toLowerCase();
                var fileSize = file.size;
                var fileType = file.type;

                // فرمت‌های تصویری و دیگر فرمت‌های مجاز
                var validImageTypes = ["gif", "jpeg", "png", "jpg"];
                var validFileTypes = {
                    "pdf": "assets/images/default/pdf.png",
                    "doc": "assets/images/default/doc.png",
                    "docx": "assets/images/default/doc.png",
                    "xls": "assets/images/default/xls.png",
                    "zip": "assets/images/default/zip.png",
                    "rar": "assets/images/default/rar.png",
                    "ppt": "assets/images/default/ppt.png",
                    "txt": "assets/images/default/txt.png",
                    "php": "assets/images/default/php.png"
                };

                var isImage = validImageTypes.includes(fileExt);
                var maxSize = isImage ? 524288 : 2097152; // 500KB برای تصاویر و 2MB برای بقیه فایل‌ها

                let errorText = inputEle.closest('.uploadWrapper').find('.errorText'); // نمایش خطا نزدیک به ورودی

                if (fileSize > maxSize) {
                    errorText.removeClass('hiddenClass').html('حجم فایل انتخابی بیشتر از حد مجاز است!');
                    return;
                } else {
                    errorText.addClass('hiddenClass').html('');
                }

                // نمایش نام فایل
                let displayName = fileName.length > 15 ? fileName.substring(0, 12) + '...' + fileExt : fileName;
                inputEle.parent('label').children('span.uploadName').html(displayName);

                let previewEle = $('#' + inputEle.data('img'));

                if (isImage) {
                    // پیش‌نمایش تصویر
                    let reader = new FileReader();
                    reader.onload = function () {
                        previewEle.attr('src', reader.result);
                    };
                    reader.readAsDataURL(file);
                } else {
                    // نمایش آیکون متناسب با نوع فایل
                    let fileIcon = validFileTypes[fileExt] ? `{{ asset('${validFileTypes[fileExt]}') }}` : `{{ asset('assets/images/default/file.png') }}`;
                    previewEle.attr('src', fileIcon);
                }
            }
        }
    });

//    transaction page

