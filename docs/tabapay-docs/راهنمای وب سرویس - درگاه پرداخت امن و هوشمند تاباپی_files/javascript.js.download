$(document).on('change', 'input[type=file]', function () {

    if (this.files[0]) {
        let reader = new FileReader();

        reader.onload = (e) => {
            var dataimg=$(this).attr("data-img");
            $('#'+dataimg).attr('src', e.target.result);
        }

        reader.readAsDataURL(this.files[0]);
    }
})
