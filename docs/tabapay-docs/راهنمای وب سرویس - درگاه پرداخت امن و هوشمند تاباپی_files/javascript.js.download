    //------------- validate card number
    $('input[name=number]').keyup(function (e) {
        if (!checkControlkeys(e)) {
            // if( !isNaN(e.key)){
            //     console.log('ente 1')
            let code = e.target.value.replace(/-/g, '');
            let L = code.length;
            if (L < 16 || parseInt(code.substr(1, 10), 10) == 0 || parseInt(code.substr(10, 6), 10) == 0) {
                return false;
            }
            let c = parseInt(code.substr(15, 1), 10);
            let s = 0;
            let k, d;
            for (let i = 0; i < 16; i++) {
                k = (i % 2 == 0) ? 2 : 1;
                d = parseInt(code.substr(i, 1), 10) * k;
                s += (d > 9) ? d - 9 : d;
            }//end for
            if ((s % 10) != 0) $(this).addClass('Error');
            else $(this).removeClass('Error');
        }

    });//card number blur
